<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Заливка цветом -->
    <solid android:color="@color/search_area" />

    <!-- Скругление углов -->
    <corners android:radius="8dp" />

    <!-- Опционально: обводка -->
    <stroke
        android:width="1dp"
        android:color="@color/search_area" />

    <!-- Опционально: внутренние отступы -->
    <padding
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="0dp" />
</shape>