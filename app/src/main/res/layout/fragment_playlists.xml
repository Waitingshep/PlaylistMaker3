<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/windowBackground">

    <!-- Кнопка "Новый плейлист" -->
    <Button
        android:id="@+id/createPlaylistButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:text="@string/new_playlist"
        android:backgroundTint="@color/media_button"
        android:textColor="@color/media_button_text"
        android:fontFamily="@font/ys_display_medium"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:textFontWeight="500"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        app:cornerRadius="54dp" />

    <!-- Контейнер для заглушки и списка -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Заглушка -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="46dp">

            <ImageView
                android:id="@+id/emptyPlaylistImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_nothing_found_120"
                android:visibility="gone" />

            <TextView
                android:id="@+id/emptyPlaylistText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/no_playlists"
                android:textSize="19sp"
                android:fontFamily="@font/ys_display_medium"
                android:textColor="@color/placeholder_text"
                android:textFontWeight="500"
                android:gravity="center"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Список плейлистов -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/playlistsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:clipToPadding="false"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>