<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_bg"
    android:padding="16dp"
    >

    <!-- Ручка для свайпа -->
    <View
        android:layout_width="50dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/singer_search"
        android:layout_marginBottom="16dp" />

    <!-- Заголовок -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/add_playlist"
        android:textSize="19sp"
        android:fontFamily="@font/ys_display_medium"
        android:textColor="@color/song_name_search"
        android:layout_marginBottom="16dp" />

    <!-- Список плейлистов -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/playlistRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="true" />

    <!-- Кнопка "Новый плейлист" -->
    <Button
        android:id="@+id/createPlaylistButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/new_playlist"
        android:textAllCaps="false"
        android:fontFamily="@font/ys_display_medium"
        android:textSize="14sp"
        app:backgroundTint="@color/media_button"
        android:textColor="@color/media_button_text"
        app:cornerRadius="54dp" />

</LinearLayout>