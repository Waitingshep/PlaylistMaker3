<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:gravity="center"
    android:visibility="gone"
    android:id="@+id/placeholderError">

    <ImageView
        android:id="@+id/errorImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_error_120" />

    <TextView
        android:id="@+id/errorText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textFontWeight="400"
        android:text="@string/something_went_wrong"
        android:textSize="@dimen/placeholder_text"
        android:fontFamily="@font/ys_display_medium"
        android:textColor="@color/placeholder_text"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"
        android:gravity="center"/>

    <Button
        android:id="@+id/refreshButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/update"
        android:textSize="@dimen/refresh_button_text"
        android:fontFamily="@font/ys_display_medium"
        android:backgroundTint="@color/refresh_button_bg"
        android:textColor="@color/refresh_button_text"
        android:textFontWeight="500"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        app:cornerRadius="54dp"
        android:textAllCaps="false" />


</LinearLayout>